# Copy to .env and replace every placeholder before starting the stack.
# Generate shell-safe passwords with: openssl rand -hex 32
POSTGRES_DB=ops_lab
POSTGRES_USER=ops_lab
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

GRAFANA_ADMIN_USER=opsadmin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Keep the dashboard and monitoring interfaces bound to localhost by default.
WEB_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optional: change backup retention. Dumps are stored outside the database container.
BACKUP_RETENTION_DAYS=14
